DATABASE_URL=postgresql://loop:loop@localhost:5432/loop
# at least 32 chars; generate with: openssl rand -base64 48
JWT_SECRET=change-me-change-me-change-me-change-me
PORT=3000
REDIS_URL=redis://localhost:6379
# S3-compatible storage (MinIO in docker-compose; Cloudflare R2 etc. in production)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=loop-uploads
S3_ACCESS_KEY=loopminio
S3_SECRET_KEY=loopminio-secret
# LiveKit (voice/video). Dev/test: docker-compose service + docker/livekit.yaml; production: LiveKit Cloud.
# LIVEKIT_URL is what clients connect to (ws/wss); LIVEKIT_API_URL is what the server calls (http/https).
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_URL=http://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=loop-dev-livekit-secret-0123456789abcdef
# Browser origins allowed to call the API (comma-separated). Desktop dev = Vite dev server, production = app://loop.
# Unset or empty = no cross-origin access (fail-safe).
CORS_ORIGINS=http://localhost:5173,app://loop
# Rate limiting is ON unless this is exactly "off". "off" is for local dev / e2e / tests ONLY (they sign up dozens of
# users from one address in seconds); leave it unset or "on" in production.
RATE_LIMIT=off
# Only behind a reverse proxy/CDN: off (default) | true (trust X-Forwarded-For as sent) | N (trust N proxy hops, safest).
# Wrong value = every user shares the proxy's address, or a client can spoof its own. Unset when not behind a proxy.
# TRUST_PROXY=1
# Link previews (on unless exactly "off"): the server fetches pages linked in messages, from its own IP.
# LINK_PREVIEWS=off
# GIF search in the composer (GIPHY). Unset = the feature is off and the desktop hides its GIF button.
# Free key: developers.giphy.com (create an app, choose API). Never sent to clients.
# GIPHY_API_KEY=
