DATABASE_URL=postgresql://loop:loop@localhost:5432/loop
# at least 32 chars; generate with: openssl rand -base64 48
JWT_SECRET=change-me-change-me-change-me-change-me
PORT=3000
REDIS_URL=redis://localhost:6379
# S3-compatible storage (MinIO in docker-compose; Cloudflare R2 etc. in production)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=loop-uploads
S3_ACCESS_KEY=loopminio
S3_SECRET_KEY=loopminio-secret
# LiveKit (voice/video). Dev/test: docker-compose service + docker/livekit.yaml; production: LiveKit Cloud.
# LIVEKIT_URL is what clients connect to (ws/wss); LIVEKIT_API_URL is what the server calls (http/https).
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_URL=http://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=loop-dev-livekit-secret-0123456789abcdef
