# Copy to deploy/.env (same folder as docker-compose.prod.yml) and fill in. NEVER commit the real file.
# Use only letters, digits, - _ . in passwords that go into URLs: `openssl rand -hex 24` is a good generator.

# --- Public host name (DuckDNS subdomain or your own domain), DNS pointing at this machine, ports 80/443 open ---
DOMAIN=loop-test.duckdns.org

# --- Passwords of the two internal services (not reachable from outside) ---
# generate: openssl rand -hex 24
POSTGRES_PASSWORD=
# generate: openssl rand -hex 24
REDIS_PASSWORD=

# --- Server secrets ---
# signs login tokens, at least 32 characters. generate: openssl rand -base64 48
JWT_SECRET=

# --- File storage: Cloudflare R2 (S3-compatible). R2 dashboard -> your bucket + "Manage R2 API Tokens" ---
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=loop-uploads
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Voice/video: LiveKit Cloud project (Settings -> Keys). URLs look like the ones below ---
# what the desktop app connects to (wss)
LIVEKIT_URL=wss://<project>.livekit.cloud
# what the server calls (https)
LIVEKIT_API_URL=https://<project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Optional ---
# Browser origins allowed to call the API. The packaged desktop app is app://loop.
# CORS_ORIGINS=app://loop
# Image tag for the server (default loop-server:local, built by `docker compose build`).
# LOOP_SERVER_IMAGE=loop-server:local
# Host ports of Caddy (default 80/443; only change for local testing).
# HTTP_PORT=80
# HTTPS_PORT=443
# Compose project name (default loop-prod).
# COMPOSE_PROJECT_NAME=loop-prod
# Fixed by docker-compose.prod.yml and not read from here: RATE_LIMIT=on, TRUST_PROXY=1, PORT=3000.
