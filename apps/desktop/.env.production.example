# Build-time addresses baked into the installers (src/shared/config.ts). `pnpm --filter @loop/desktop dist` refuses to
# build unless the first three are https/wss and not localhost (scripts/check-release-env.mjs).
# Local build: copy these lines into your shell (`set -a; . apps/desktop/.env.production; set +a`) or export them.
# In GitHub Actions they come from repository VARIABLES (Settings -> Secrets and variables -> Actions -> Variables).

# The server's public address (your DOMAIN from deploy/.env), no trailing path.
VITE_API_URL=https://loop-test.duckdns.org
# Origin of the R2 endpoint = S3_ENDPOINT in deploy/.env (uploads and images go straight there).
VITE_STORAGE_ORIGIN=https://<account-id>.r2.cloudflarestorage.com
# LIVEKIT_URL in deploy/.env (wss).
VITE_LIVEKIT_ORIGIN=wss://<project>.livekit.cloud
# Optional: https folder that holds latest.yml / latest-mac.yml and the installers. Empty = no automatic updates.
# VITE_UPDATE_URL=https://example.com/loop-releases
