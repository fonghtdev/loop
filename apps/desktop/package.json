{
  "name": "@loop/desktop",
  "version": "0.3.0",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "e2e": "electron-vite build && playwright test",
    "dist": "node scripts/check-release-env.mjs && electron-vite build && electron-builder --publish never",
    "dist:dir": "node scripts/check-release-env.mjs && electron-vite build && electron-builder --publish never --dir",
    "dist:mac": "node scripts/check-release-env.mjs && electron-vite build && electron-builder --publish never --mac",
    "dist:win": "node scripts/check-release-env.mjs && electron-vite build && electron-builder --publish never --win --x64"
  },
  "dependencies": {
    "@sapphi-red/web-noise-suppressor": "0.4.1",
    "animejs": "4.4.1",
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@fontsource/be-vietnam-pro": "5.3.0",
    "@livekit/rtc-node": "1.1.0",
    "@loop/shared": "workspace:*",
    "@phosphor-icons/react": "2.1.10",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.104.1",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "livekit-client": "2.9.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "socket.io-client": "4.8.4",
    "tailwindcss": "4.3.3",
    "vite": "7.3.7",
    "vitest": "4.1.11",
    "zustand": "5.0.15"
  },
  "description": "Loop",
  "author": "Loop"
}
