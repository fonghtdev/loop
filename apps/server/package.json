{
  "name": "@loop/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "prisma generate",
    "build": "prisma generate && tsc",
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "start": "node --env-file=../../.env dist/server.js",
    "db:migrate": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js migrate dev",
    "db:deploy": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js migrate deploy",
    "test": "prisma generate && vitest run"
  },
  "devDependencies": {
    "@livekit/rtc-node": "^1.1.0",
    "@types/node": "^26.6.4",
    "prisma": "^6.19.3",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1148.0",
    "@aws-sdk/s3-request-presigner": "^3.1148.0",
    "@fastify/cors": "^11.3.1",
    "@loop/shared": "workspace:*",
    "@prisma/client": "^6.19.3",
    "@socket.io/redis-adapter": "^8.3.0",
    "argon2": "^0.45.1",
    "fastify": "^5.12.5",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "livekit-server-sdk": "^2.19.1",
    "socket.io": "^4.8.4",
    "zod": "^3.25.76"
  }
}
